// Sky dome colour (0x5B8D54) towards `dir` (unit) seen from `eye` (cm):
// sun colour x (Rayleigh (1 + cos^2) + Mie (1 + g^2 - 2 g cos)^-1.5).
// Stars are not drawn.
fn sky_color(cb: array<vec4<f32>, 11>, tr: texture_2d<f32>, tm: texture_2d<f32>, eye: vec3<f32>, dir: vec3<f32>) -> vec3<f32> {
    let rayleigh = scatter_rayleigh(cb, tr, tm, eye, dir);
    let mie = scatter_mie(cb, tr, tm, eye, dir);
    let c = dot(cb[7].xyz, dir);
    let mie_phase = pow(abs(cb[8].w * c + cb[8].z), -1.5);
    return max(cb[6].xyz * (rayleigh * (c * c + 1.0) + mie * mie_phase), vec3<f32>(0.0));
}
