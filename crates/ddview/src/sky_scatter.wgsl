fn point_load(t: texture_2d<f32>, uv: vec2<f32>) -> vec4<f32> {
    let n = vec2<i32>(textureDimensions(t));
    let p = clamp(vec2<i32>(floor(uv * vec2<f32>(n))), vec2<i32>(0), n - vec2<i32>(1));
    return textureLoad(t, p, 0);
}

fn depth_tex(t: texture_2d<f32>, c: vec4<f32>) -> vec4<f32> {
    return point_load(t, c.xy);
}

